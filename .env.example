# Privy — https://dashboard.privy.io
# Create an app, then copy the App ID (starts with cl…)
VITE_PRIVY_APP_ID=

# Intuition GraphQL indexer (used by @0xintuition/sdk globalSearch)
# Defaults to mainnet production API if unset.
# VITE_INTUITION_GRAPHQL_URL=https://mainnet.intuition.sh/v1/graphql

# Privy dashboard (required for correct default network):
# - Settings → Chains: add custom chain Intuition Mainnet (1155)
#   RPC: https://rpc.intuition.systems/http
# - Disable Base / other chains if you only want Intuition
# - Default chain: Intuition Mainnet (1155)

# Optional extra TRUST (wei) deposited into the new triple vault on submit.
# Base triple cost is read from the MultiVault contract automatically.
# VITE_TRIPLE_DEPOSIT_WEI=1000000000000000000
